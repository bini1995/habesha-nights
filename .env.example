# Application server
PORT=3000

# Supabase server connection. Prefer the newer sb_secret_ key when available.
# Never expose either secret key to browser code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
# Legacy projects may use this instead of SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_FLYER_BUCKET=event-flyers

# Private /admin access. Generate two separate long random values.
ADMIN_TOKEN=
CLICK_HASH_SALT=
