RESEND_API_KEY=your_resend_api_key_here
ALERT_EMAIL_TO=your_email@example.com
ALERT_EMAIL_FROM=NYC Opportunity Agent <alerts@example.com>

# Optional sports-only deployment boundaries. Both default to enabled.
LEGACY_MONITORING_ENABLED=true
EVENT_FINDER_ENABLED=true

# Optional roster screenshot extraction. Images are sent to the OpenAI
# Responses API only after the user confirms the disclosure in the UI.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_VISION_MODEL=gpt-5.4-mini
