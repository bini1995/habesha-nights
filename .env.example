RESEND_API_KEY=your_resend_api_key_here
ALERT_EMAIL_TO=your_email@example.com
ALERT_EMAIL_FROM=NYC Opportunity Agent <alerts@example.com>

# Optional sports-only deployment boundaries. Both default to enabled.
LEGACY_MONITORING_ENABLED=true
EVENT_FINDER_ENABLED=true

# Optional roster screenshot extraction. Images are sent to the OpenAI
# Responses API only after the user confirms the disclosure in the UI.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_VISION_MODEL=gpt-5.4-mini

# Phase 3F defaults to a fictional offline directory. A licensed live adapter
# must be implemented and explicitly selected before real player data is used.
SPORTS_DATA_PROVIDER=offline-sample

# Phase 3J hosted beta. Keep all three blank until a Supabase staging project
# exists. SUPABASE_SECRET_KEY is server-only and must never enter browser code.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
