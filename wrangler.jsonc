{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "habesha-nights",
  "main": "./worker/index.mjs",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ratelimits": [
    {
      "name": "SUBMISSION_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "vars": {
    "SUPABASE_URL": "https://qtrygxlptvcnxwhehhyb.supabase.co",
    "SUPABASE_FLYER_BUCKET": "event-flyers"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
